hook_impl: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 hook_impl
.PHONY : hook_impl

# fast build rule for target.
hook_impl/fast:
	$(MAKE) $(MAKESILENT) -f adrenotools/src/hook/CMakeFiles/hook_impl.dir/build.make adrenotools/src/hook/CMakeFiles/hook_impl.dir/build
.PHONY : hook_impl/fast

