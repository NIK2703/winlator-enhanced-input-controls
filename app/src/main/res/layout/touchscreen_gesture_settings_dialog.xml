<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timing"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/colorPrimary" />

        <View style="@style/HorizontalLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long Press Timeout (ms)"
            android:layout_marginTop="8dp" />

        <com.winlator.cmod.widget.NumberPicker
            android:id="@+id/NPLongPressTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:minValue="50"
            app:maxValue="500"
            app:step="10"
            app:value="200" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Double Tap Timeout (ms)"
            android:layout_marginTop="8dp" />

        <com.winlator.cmod.widget.NumberPicker
            android:id="@+id/NPDoubleTapTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:minValue="50"
            app:maxValue="500"
            app:step="10"
            app:value="150" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drag Threshold (px)"
            android:layout_marginTop="8dp" />

        <com.winlator.cmod.widget.NumberPicker
            android:id="@+id/NPDragThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:minValue="0"
            app:maxValue="30"
            app:step="1"
            app:value="10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single Finger Gestures"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/colorPrimary" />

        <View style="@style/HorizontalLine" />

        <LinearLayout
            android:id="@+id/LLSingleFinger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold Mode"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorPrimary" />

            <ImageView
                android:id="@+id/BTHelpHoldMode"
                style="@style/HelpButton" />
        </LinearLayout>

        <View style="@style/HorizontalLine" />

        <Spinner
            android:id="@+id/SPHoldMode"
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dialog" />

        <LinearLayout
            android:id="@+id/LLHoldModeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold Gestures"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorPrimary" />

            <View style="@style/HorizontalLine" />

            <LinearLayout
                android:id="@+id/LLHoldGestures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLTwoFingerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Two-Finger Gestures"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorPrimary" />

                <ImageView
                    android:id="@+id/BTHelpTwoFinger"
                    style="@style/HelpButton" />
            </LinearLayout>

            <View style="@style/HorizontalLine" />

            <LinearLayout
                android:id="@+id/LLTwoFinger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
