<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timing"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/colorPrimary" />

        <View style="@style/HorizontalLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long Press Timeout (ms)"
            android:layout_marginTop="8dp" />

        <com.winlator.cmod.widget.NumberPicker
            android:id="@+id/NPLongPressTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:minValue="50"
            app:maxValue="500"
            app:step="10"
            app:value="200" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Double Tap Timeout (ms)"
            android:layout_marginTop="8dp" />

        <com.winlator.cmod.widget.NumberPicker
            android:id="@+id/NPDoubleTapTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:minValue="50"
            app:maxValue="500"
            app:step="10"
            app:value="150" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drag Threshold (px)"
            android:layout_marginTop="8dp" />

        <com.winlator.cmod.widget.NumberPicker
            android:id="@+id/NPDragThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:minValue="0"
            app:maxValue="30"
            app:step="1"
            app:value="10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cursor Speed"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/SBCursorSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="27" />

            <TextView
                android:id="@+id/TVCursorSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:minWidth="48dp"
                android:gravity="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Single Finger Gestures"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/colorPrimary" />

        <View style="@style/HorizontalLine" />

        <LinearLayout
            android:id="@+id/LLSingleFinger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold Gestures"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorPrimary" />

            <ImageView
                android:id="@+id/BTHelpHoldGestures"
                style="@style/HelpButton" />
        </LinearLayout>

        <View style="@style/HorizontalLine" />

        <LinearLayout
            android:id="@+id/LLHoldGestures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Two-Finger Gestures"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/colorPrimary" />

            <ImageView
                android:id="@+id/BTHelpTwoFinger"
                style="@style/HelpButton" />
        </LinearLayout>

        <View style="@style/HorizontalLine" />

        <LinearLayout
            android:id="@+id/LLTwoFinger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
