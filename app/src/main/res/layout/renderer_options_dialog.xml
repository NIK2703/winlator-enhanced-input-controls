<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Present Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Present Mode"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:paddingBottom="4dp"/>
            <Spinner
                android:id="@+id/SPRendererPresentMode"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:spinnerMode="dialog"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/GroupDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Renderer Driver"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:paddingBottom="4dp"/>
                <Spinner
                    android:id="@+id/SPRendererDriver"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:spinnerMode="dialog"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/GroupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Texture Filter"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:paddingBottom="4dp"/>
                <Spinner
                    android:id="@+id/SPRendererFilter"
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:spinnerMode="dialog"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh Rate"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/SPRendererRefreshRate"
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:spinnerMode="dialog"/>

            <CheckBox
                android:id="@+id/CBRendererSwapRB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Swap red/blue channels" />

            <CheckBox
                android:id="@+id/CBGridRendering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Half Resolution Grid Rendering" />

            <LinearLayout
                android:id="@+id/GroupGridDarken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grid Darken"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:paddingBottom="4dp"
                    android:layout_marginTop="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <SeekBar
                        android:id="@+id/SBGridDarken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="50" />
                    <TextView
                        android:id="@+id/TVGridDarken"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25%" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grid Cycle Interval (OLED)"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:paddingBottom="4dp"
                    android:layout_marginTop="8dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <SeekBar
                        android:id="@+id/SBGridCycleInterval"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="240"
                        android:progress="0" />
                    <TextView
                        android:id="@+id/TVGridCycleInterval"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Off" />
                </LinearLayout>
                <TextView
                    android:id="@+id/TVGridCycleWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use on your own risk"
                    android:textColor="#FF6B6B"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
